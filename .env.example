# Optional but recommended. With "Full" on in the player, songs play the full
# track from YouTube (in a small video window) instead of the 30s preview.
# Free key: Google Cloud console → enable "YouTube Data API v3" → Credentials → API key.
# Each new song lookup uses 100 of the free 10,000 daily units (~100 new songs/day);
# lookups are cached, so replays are free.
YOUTUBE_API_KEY=

# Optional. Turns on the Loops type and adds Freesound vocal phrases.
# Free key: https://freesound.org/apiv2/apply
FREESOUND_API_KEY=

# Optional. Lets you connect SoundCloud to browse your likes and playlists and turn
# them into crates. Register an app at https://soundcloud.com/you/apps and set its
# redirect URI to <your site>/api/soundcloud/callback
# (e.g. http://localhost:3000/api/soundcloud/callback for local use).
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=

# Optional. Accounts (email + password) so crates and saves follow you across devices.
# Without these, curator runs in guest mode: everything stays in the browser.
# Create a free project at https://supabase.com, run supabase/schema.sql in its SQL
# editor, then copy the Project URL and the anon public key from Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
